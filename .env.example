# RankArena environment variables

# Public Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public browser key from Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Private service role key.
# Keep this only in server/hosting secrets. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public URL of the deployed app, used by auth redirects when configured.
NEXT_PUBLIC_APP_URL="https://your-domain.com"
